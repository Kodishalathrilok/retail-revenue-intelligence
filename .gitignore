# --- Secrets: keep this first and keep it accurate ---
.env
.env.*
!.env.example
*.pgpass

# --- Raw data ---
# Raw CSVs live outside the repo (see RRIP_DUNNHUMBY_RAW_DIR in .env.example).
# These entries remain as a guard in case anyone unzips into the working tree.
data/
*.csv
*.zip
!tests/fixtures/**/*.csv

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Generated reports (produced by real runs, not committed) ---
reports/
docs/_generated/

# --- Node / Next.js (Phase 7) ---
node_modules/
.next/
out/

# --- Editor / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- LLM development response cache ---
.cache/

# --- Frontend ---
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts

# Adjudication artefacts. The *.csv rule above exists for the raw dunnhumby
# data; these are evidence and are tracked deliberately.
!evals/narration/adjudication_worksheet.csv
!evals/narration/adjudication_worksheet_human.csv
!evals/narration/adjudication_judge.csv

# The KEY is NOT tracked. It maps opaque row ids back to arm and case, which is
# the whole thing the worksheet is blinded against -- committing it alongside
# the worksheet would undo the blinding for anyone re-running the audit.
evals/narration/adjudication_key.csv
