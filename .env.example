# Copy to .env and fill in. .env is gitignored.

# --- Postgres (native install, Phase 1+) ---
RRIP_PG_HOST=localhost
RRIP_PG_PORT=5432
RRIP_PG_USER=postgres
RRIP_PG_PASSWORD=
RRIP_PG_DATABASE=rrip

# --- Paths ---
# Directory holding the unzipped dunnhumby "Complete Journey" CSVs.
#
# Kept OUTSIDE the repo deliberately: the raw files are ~1.5 GB, and hosting
# them under a synced folder (OneDrive, Dropbox) risks Files On-Demand
# dehydrating them, which stalls the loader on what looks like a present file.
# Absolute and repo-relative paths both work.
RRIP_DUNNHUMBY_RAW_DIR=C:/data/dunnhumby

# --- Anthropic (Phase 6, not needed before then) ---
ANTHROPIC_API_KEY=
