# Copy to .env and fill in. .env is gitignored.

# --- Postgres (native install, Phase 1+) ---
# A full DSN takes precedence over the fields below. Use it for hosted
# Postgres, whose connection string carries sslmode and other options that
# reassembling from parts would drop.
#
# These are the LOADER's credentials and need write access: `rrip load` and
# `rrip publish` create and populate tables. The API uses the separate
# read-only DSN below instead.
RRIP_PG_DSN=
RRIP_PG_HOST=localhost
RRIP_PG_PORT=5432
RRIP_PG_USER=postgres
RRIP_PG_PASSWORD=
RRIP_PG_DATABASE=rrip

# --- API database credentials. REQUIRED before exposing the API publicly. ---
#
# The API plans and executes SQL a language model proposed. The six validation
# gates in src/rrip/ai/nl2sql.py are defence in depth, not a privilege
# boundary -- one bypass already got past them. The boundary is this role.
#
# Create it with:  psql -U postgres -d rrip -v ro_password='...' \
#                       -f sql/ddl/60_readonly_role.sql
# then set the DSN here, e.g.
#   postgresql://rrip_ro:<password>@localhost:5432/rrip
#
# Left empty, the API falls back to the loader credentials above and logs a
# warning at startup. That is for a fresh clone, not for a deployment.
RRIP_PG_READONLY_DSN=

# --- Paths ---
# Directory holding the unzipped dunnhumby "Complete Journey" CSVs.
#
# Kept OUTSIDE the repo deliberately: the raw files are ~1.5 GB, and hosting
# them under a synced folder (OneDrive, Dropbox) risks Files On-Demand
# dehydrating them, which stalls the loader on what looks like a present file.
# Absolute and repo-relative paths both work.
RRIP_DUNNHUMBY_RAW_DIR=C:/data/dunnhumby

# --- API bind address (Phase 5) ---
# Configurable so a port collision is an env change, not a code change.
RRIP_API_HOST=127.0.0.1
RRIP_API_PORT=8010

# Which data tier the API reads: local (full star schema) or published (pub_* only).
RRIP_TIER=local

# Browser origins allowed to call the API. Add the deployed frontend URL here --
# a CORS mismatch fails only in the browser, so it is easy to misdiagnose.
RRIP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Publish target (Phase 8). Hosted Postgres for the pub_* aggregate tier. ---
# Empty means `rrip publish` builds and measures locally without pushing.
RRIP_PUBLISH_DSN=

# --- LLM provider (Phase 6). Free tiers only; no Anthropic API key is used. ---
# Provider is config-switched, never hardcoded at a call site.
RRIP_LLM_PROVIDER=gemini          # gemini | groq | fake
GEMINI_API_KEY=
GROQ_API_KEY=
RRIP_LLM_CACHE=1                  # 0 disables the dev response cache
